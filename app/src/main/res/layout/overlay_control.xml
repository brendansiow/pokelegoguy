<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ─── COLLAPSED: small draggable pill ─── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCollapsed"
        android:layout_width="68dp"
        android:layout_height="40dp"
        app:cardBackgroundColor="#EE111124"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖"
                android:textSize="18sp" />

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/status_dot_gray" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ─── EXPANDED: full control card ─── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardExpanded"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="#F00D0D1A"
        app:cardCornerRadius="16dp"
        app:cardElevation="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Drag handle — touch here to drag the whole overlay -->
            <LinearLayout
                android:id="@+id/viewDragHandle"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#28FFFFFF">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:background="#66FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="14dp">

                <!-- Header: title + minimise button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pokemon Bot"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <!-- Minimise button (text "−") -->
                    <TextView
                        android:id="@+id/btnMinimize"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="#CCFFFFFF"
                        android:textSize="22sp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Status line -->
                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="● Stopped"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <!-- Last AI action -->
                <TextView
                    android:id="@+id/tvLastAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Last action: —"
                    android:textColor="#77FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginBottom="14dp" />

                <!-- Open App / Settings button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayOpenApp"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="Open App"
                    android:textSize="12sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_marginBottom="7dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="#556699AA"
                    android:textColor="#99CCFF" />

                <!-- Stop Bot — only visible while bot is running -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayStop"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="Stop Bot"
                    android:textSize="12sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:visibility="gone"
                    app:backgroundTint="#CC7B0000"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
